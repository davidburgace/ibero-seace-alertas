# ─── Radar Ibero — variables de entorno ─────────────────────────────────────
# Copia este archivo a .env (local) o cárgalas en Render → Environment.
# NUNCA subas valores reales al repositorio.

# Servidor
PORT=3000
FRONTEND_URL=https://ibero-seace-alertas.onrender.com

# Supabase (backend: clave secreta / service role; salta RLS, solo en el servidor)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=
# (alternativa antigua) SUPABASE_SERVICE_ROLE_KEY=

# Supabase (navegador: clave pública/publishable, la usa el login de Radar IOARR)
SUPABASE_PUBLISHABLE_KEY=

# OpenAI (SEACE Radar / Radar Infra)
OPENAI_API_KEY=

# Correo por SMTP (p. ej. SendGrid: host smtp.sendgrid.net, usuario "apikey", pass = API key)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=
MAIL_FROM=Radar Ibero <alertas@tu-dominio.com>

# Crons existentes
CRON_SCHEDULE=0 8 * * *
INFRA_CRON=0 9 * * 1
RECORDATORIO_VENTANA_MIN=60
MEF_OXI_XLSX_URL=

# Radar IOARR — hora del correo diario (zona America/Lima)
IOARR_CRON=0 7 * * *
